AWS_PROFILE=netpulse-root
AWS_REGION=us-east-1
APP_RUNNER_SERVICE_ARN=arn:aws:apprunner:us-east-1:194191749520:service/ai-system-shared-ai-platform/c9657b9d07fc43448a3e787d5b8c0a38
ECS_EXPRESS_SERVICE_NAME=ai-system-shared-ai-platform-ecs
ECS_CLUSTER=default
EXECUTION_ROLE_NAME=ecsTaskExecutionRole
INFRASTRUCTURE_ROLE_NAME=ecsInfrastructureRoleForExpressServices
CONTAINER_IMAGE=194191749520.dkr.ecr.us-east-1.amazonaws.com/ai-system-shared-ai-platform:latest
CONTAINER_PORT=3000
CPU=256
MEMORY=1024
HEALTH_CHECK_PATH=/health
MIN_TASK_COUNT=1
MAX_TASK_COUNT=1
AUTO_SCALING_METRIC=AVERAGE_CPU
AUTO_SCALING_TARGET_VALUE=60
ENV_VARS_JSON='{"NODE_ENV":"production","OPENAI_MODEL":"gpt-4o-mini","PORT":"3000","PROJECT_TOOL_ALLOWLIST_JSON":"{\"default\":[\"echo\",\"write_audit_note\",\"telecom_dispatch\",\"cloud_code_exec\"]}"}'
