NODE_ENV=development
PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AUTH_MODE=none
REQUIRE_API_KEY=false
API_KEYS_JSON={"internal-key":"default"}
JWT_SHARED_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
COGNITO_REGION=
COGNITO_USER_POOL_ID=
JWT_PROJECT_CLAIM=project_id
JWT_USER_CLAIM=sub
RUN_TIMEOUT_MS=45000
MAX_PLAN_STEPS=6
RETRY_TRANSIENT=2
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000
MESSAGE_RATE_PER_MINUTE=60
GLOBAL_RATE_PER_MINUTE=240
RETENTION_DAYS=30
ENFORCE_COST_BUDGET=true
DEFAULT_DAILY_COST_BUDGET_USD=5
PROJECT_DAILY_COST_BUDGETS_JSON={"default":5}
TOOL_CALL_COST_USD=0.0002
POLICY_FAIL_CLOSED_SCOPES=write,admin,payment
PROJECT_TOOL_ALLOWLIST_JSON={"default":["echo","write_audit_note","telecom_dispatch","cloud_code_exec"]}
NETPULSE_ENDPOINT=
