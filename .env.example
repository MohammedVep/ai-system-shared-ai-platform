NODE_ENV=development
PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REQUIRE_API_KEY=false
API_KEYS_JSON={"internal-key":"default"}
RUN_TIMEOUT_MS=45000
MAX_PLAN_STEPS=6
RETRY_TRANSIENT=2
MESSAGE_RATE_PER_MINUTE=60
RETENTION_DAYS=30
POLICY_FAIL_CLOSED_SCOPES=write,admin,payment
PROJECT_TOOL_ALLOWLIST_JSON={"default":["echo","write_audit_note","telecom_dispatch","cloud_code_exec"]}
NETPULSE_ENDPOINT=
